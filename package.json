{
  "name": "agentic-tracking",
  "version": "0.2.0",
  "description": "Call attribution for Twilio, Telnyx, Cloudflare D1, and Stripe with a TypeScript SDK, CLI, and Model Context Protocol server.",
  "keywords": [
    "call-tracking",
    "call-attribution",
    "twilio",
    "telnyx",
    "cloudflare-d1",
    "stripe",
    "meter-events",
    "typescript",
    "nodejs",
    "cli",
    "mcp",
    "jsonl"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-tracking.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "server.json",
    ".mcp.json",
    "AGENTS.md",
    "RULES.md",
    "SKILL.md",
    "llms.txt",
    "agentic-core.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-tracking",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-tracking": "./dist/cli.js",
    "agentic-tracking-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0",
    "agentic-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
