{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pooriaarab/agentic-tracking",
  "description": "Attribute calls to lines and credit leads.",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/pooriaarab/agentic-tracking.git",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "agentic-tracking",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "subcommand",
          "value": "mcp"
        }
      ]
    }
  ]
}
